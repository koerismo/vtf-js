{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ESNext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"alwaysStrict": true,
		"strict": true,
		"sourceMap": true,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist",
		"stripInternal": true
	},
	"include": [ "src/" ]
}